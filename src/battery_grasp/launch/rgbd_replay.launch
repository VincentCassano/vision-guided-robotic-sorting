<launch>
  <arg name="inference_python"/>
  <arg name="repository"/>
  <arg name="square_confidence" default=""/>
  <arg name="class_confidences" default=""/>
  <arg name="calibrated_v3" default="true"/>
  <include file="$(find battery_grasp)/launch/yolo_replay.launch">
    <arg name="inference_python" value="$(arg inference_python)"/>
    <arg name="repository" value="$(arg repository)"/>
    <arg name="square_confidence" value="$(arg square_confidence)"/>
    <arg name="class_confidences" value="$(arg class_confidences)"/>
    <arg name="calibrated_v3" value="$(arg calibrated_v3)"/>
    <arg name="synthetic_depth" value="true"/>
  </include>
  <node pkg="battery_grasp" type="vision_depth_test.py" name="vision_depth_test" output="screen" required="true">
    <remap from="~detections" to="/battery_vision/detections"/>
    <remap from="~depth" to="/battery_vision/depth"/>
    <remap from="~camera_info" to="/battery_vision/camera_info"/>
    <remap from="~objects" to="/battery_vision/objects_3d"/>
  </node>
</launch>
